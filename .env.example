# Copy to .env for local runs on station D. In GitHub Actions these are repository
# secrets instead — never commit a filled-in .env.
#
# ── The one rule that matters ────────────────────────────────────────────────
#
# Four channels means four sets of platform credentials. Any variable below can be
# suffixed with a channel's slug in upper case to make it channel-specific:
#
#   YOUTUBE_REFRESH_TOKEN_WEALTHVAULT_INSIDER   ← used by that channel
#   YOUTUBE_REFRESH_TOKEN                       ← fallback for every channel
#
# The channel-specific one always wins. Use the shared form for anything genuinely
# shared (the Anthropic key, the OAuth client, an app secret) and the suffixed form
# for anything that identifies one account (every refresh token, the IG user id).
#
# Slugs come from the filenames in config/channels/:
#   wealthvault-insider  →  _WEALTHVAULT_INSIDER
#   ai-benefits          →  _AI_BENEFITS
#   clipvault-agency     →  _CLIPVAULT_AGENCY
#   mymixvault           →  _MYMIXVAULT
#
# `npm run health` prints the exact variable name each channel is missing.

# ---------------------------------------------------------------- scripting
# Required, shared across all channels. The scriptwriter will not run without it.
ANTHROPIC_API_KEY=
# Optional: route through a local 9router gateway instead of calling Anthropic
# directly. Only useful on station D, where 9router is running.
# LLM_BASE_URL=http://localhost:20128
LLM_MODEL=claude-opus-5

# ---------------------------------------------------------------- sourcing
# Optional. Only needed to sync titles and prices from a Whop company you have API
# access to. Without it, sourcing runs on each channel's manualProducts alone.
WHOP_API_KEY=
# WHOP_API_KEY_AI_BENEFITS=

# ---------------------------------------------------------------- rendering
# manual = you drop exports into media/inbox/  |  ffmpeg = fully automated
RENDERER=manual
ELEVENLABS_API_KEY=
# One voice per channel is what makes them feel like different channels.
ELEVENLABS_VOICE_ID=
# ELEVENLABS_VOICE_ID_AI_BENEFITS=
# MUSIC_VOLUME=0.08
# CAPTION_FONT_SIZE=64

# ---------------------------------------------------------------- youtube
# The OAuth client can be shared — one Google Cloud project covers every channel.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# The refresh token identifies the channel, so mint one per channel.
YOUTUBE_REFRESH_TOKEN_WEALTHVAULT_INSIDER=
# YOUTUBE_REFRESH_TOKEN_AI_BENEFITS=
# YOUTUBE_REFRESH_TOKEN_CLIPVAULT_AGENCY=
# YOUTUBE_REFRESH_TOKEN_MYMIXVAULT=

# ---------------------------------------------------------------- instagram
# Instagram Business/Creator account id and a long-lived page access token, per channel.
INSTAGRAM_USER_ID_WEALTHVAULT_INSIDER=
INSTAGRAM_ACCESS_TOKEN_WEALTHVAULT_INSIDER=
# INSTAGRAM_USER_ID_AI_BENEFITS=
# INSTAGRAM_ACCESS_TOKEN_AI_BENEFITS=
# META_API_VERSION=v21.0

# ---------------------------------------------------------------- tiktok
# App credentials can be shared; the refresh token identifies the account.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN_WEALTHVAULT_INSIDER=
TIKTOK_HANDLE_WEALTHVAULT_INSIDER=
# TIKTOK_REFRESH_TOKEN_AI_BENEFITS=
# TIKTOK_HANDLE_AI_BENEFITS=

# ---------------------------------------------------------------- behaviour
# Set to 1 to run every stage without touching an external service.
DRY_RUN=
LOG_LEVEL=info
# Where Instagram should fetch videos from, if you host them yourself.
# Leave unset to use GitHub Releases automatically.
# PUBLIC_MEDIA_BASE_URL=
