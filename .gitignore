# Which account belongs to which channel. Not secret, but not the repository's
# business either — and this repository is public.
PRIVATE.md

# Rendered media is large and reproducible; only the queue metadata is tracked.
# Each kind has per-channel subfolders created at runtime, so ignore both levels.
media/inbox/*
media/broll/*
media/music/*
media/out/*
!media/*/.gitkeep
!media/*/*/
media/*/*/*
!media/*/*/.gitkeep

